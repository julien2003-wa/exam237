DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME-WITH-A-LONG-UNIQUE-PASSWORD
APP_URL=https://exam237.vercel.app
BLOB_READ_WRITE_TOKEN=
CHAT_MASTER_KEY=CHANGE-ME-WITH-AT-LEAST-32-RANDOM-CHARACTERS
# Chat instantané (sans cette clé : mise à jour toutes les 4 secondes)
ABLY_API_KEY=

# Prof IA et assistant du chat (facultatif) — clé créée sur https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Facultatif : modèle (par défaut claude-haiku-5-5) et effort (low, medium, high)
ANTHROPIC_MODEL=
ASSISTANT_EFFORT=
# Seulement si la clé n'est rattachée à aucun espace de travail (workspace) de la Console
ANTHROPIC_WORKSPACE_ID=

# Le numéro WhatsApp, les prix et les dates d'examen se règlent dans Admin → Réglages (base de données).
